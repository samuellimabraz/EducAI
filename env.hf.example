# Hugging Face Endpoints Configuration
# Use this for Hugging Face Inference Endpoints instead of local vLLM

# Database Configuration
POSTGRES_USER=edumath
POSTGRES_PASSWORD=edumath123
POSTGRES_DB=edumath_db
POSTGRES_PORT=5432

# Redis Configuration  
REDIS_PORT=6379

# OlmOCR Configuration (Hugging Face Endpoint)
OLMOCR_URL=https://pcg78xduxy8hu0z6.us-east-1.aws.endpoints.huggingface.cloud/v1
OLMOCR_MODEL=allenai/olmOCR-2-7B-1025-FP8
OLMOCR_API_KEY=${HF_TOKEN}

# LLM Configuration (Hugging Face Endpoint)
LLM_URL=https://ug2beiifpi51rn3l.us-east-1.aws.endpoints.huggingface.cloud/v1
LLM_MODEL=Qwen/Qwen3-4B-Thinking-2507-FP8
LLM_API_KEY=${HF_TOKEN}

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-please-change-this-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
USE_HF_ENDPOINTS=true

# Frontend Configuration
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000

# Security
CONTENT_FILTER_ENABLED=true
MAX_MESSAGE_LENGTH=2000
MAX_IMAGE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
